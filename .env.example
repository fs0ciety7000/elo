# ============================================================
# HumaScan Medical SaaS — Variables d'environnement
# ============================================================

# URL de base de l'application
AUTH_URL=https://elodie.fs0ciety.org

# Clé secrète pour la signature des tokens JWT (32 chars minimum)
AUTH_SECRET=

# ── Google Cloud Vision (OCR) ──────────────────────────────
GOOGLE_VISION_API_KEY=

# ── Base de données PostgreSQL ─────────────────────────────
POSTGRES_USER=medical
POSTGRES_PASSWORD=
POSTGRES_DB=medical_db

# URL de connexion Prisma (le @ doit être encodé en %40 dans l'URL)
DATABASE_URL=

# ── SMTP (mailing, serveur mail.fs0ciety.org) ──────────────
# Port 465 = TLS implicite ; 587 = STARTTLS
SMTP_HOST=mail.fs0ciety.org
SMTP_PORT=587
SMTP_USER=nicolas@fs0ciety.org
SMTP_PASSWORD=
SMTP_FROM="HumaScan Medical <noreply@fs0ciety.org>"

# ── Coolify / Traefik ──────────────────────────────────────
SERVICE_URL_MEDICAL_APP=https://elodie.fs0ciety.org
SERVICE_FQDN_MEDICAL_APP=elodie.fs0ciety.org
